# Git stores text with LF. Without this, core.autocrlf writes CRLF into the
# working tree on Windows while Prettier expects LF, so `npm run format:check`
# disagrees with CI about the exact same commit. Declaring the line ending in
# the repository makes the working tree identical on every platform, which is
# what the attribute does that a local git config cannot.
* text=auto eol=lf

# Assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.keystore binary
*.jks binary
